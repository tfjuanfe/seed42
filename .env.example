# Neon Postgres — ALWAYS the pooled endpoint for the app
# (host must contain "-pooler", e.g. ep-xxx-pooler.us-east-2.aws.neon.tech)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/seed42?sslmode=require"

# Optional: direct (non-pooled) URL, used only by drizzle-kit migrations
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/seed42?sslmode=require"
